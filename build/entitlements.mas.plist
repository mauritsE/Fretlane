<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac App Store build: every App Store app runs in the App Sandbox. -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- The UI talks to Fretlane's own library server on 127.0.0.1. -->
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- YouTube videos, and downloading a tab from a link the user pastes. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Importing a tab file the user picks in the file dialog. -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
  </dict>
</plist>
