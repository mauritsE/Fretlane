<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the Developer ID (notarised) Mac build, used only when the
  Release workflow signs with a Developer ID certificate (release/SIGNING.md). Electron needs JIT and
  unsigned executable memory for V8; disable-library-validation lets it load its own frameworks.
  (electron-builder's template: https://github.com/electron-userland/electron-builder/issues/3940)
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
